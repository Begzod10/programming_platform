<Window x:Class="PcGuard.Shell.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Background="#FF1E2A38" BorderBrush="#FF8A5A00" BorderThickness="1" Title="PcGuard">
    <StackPanel Width="400" Margin="28,24">
        <TextBlock x:Name="TitleText" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock x:Name="HintText" Foreground="#FFFFD27B" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock x:Name="CodeLabel" Foreground="White" FontSize="16" Margin="0,0,0,6" />
        <!-- PasswordBox: hidden input, no copy/cut, no undo; cleared right after the code is read -->
        <PasswordBox x:Name="CodeBox" FontSize="20" Padding="6" MaxLength="128"
                     InputMethod.IsInputMethodEnabled="False" />
        <TextBlock x:Name="ErrorText" Foreground="#FFFF7B7B" FontSize="15" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="UnlockButton" IsDefault="True" FontSize="16" Padding="18,6" Click="OnUnlockClick" />
            <Button x:Name="CancelButton" FontSize="16" Padding="18,6" Margin="12,0,0,0" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>

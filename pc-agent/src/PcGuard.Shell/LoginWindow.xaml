<Window x:Class="PcGuard.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="#FF101820" Title="PcGuard">
    <Grid>
        <Button x:Name="LangButton" Content="UZ | RU" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="24" Padding="14,6" FontSize="16" Click="OnLangClick" />

        <StackPanel Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="UserLabel" Foreground="White" FontSize="16" Margin="0,0,0,4" />
            <TextBox x:Name="UserBox" FontSize="20" Padding="6" Margin="0,0,0,16" />
            <TextBlock x:Name="PwLabel" Foreground="White" FontSize="16" Margin="0,0,0,4" />
            <PasswordBox x:Name="PwBox" FontSize="20" Padding="6" Margin="0,0,0,20" />
            <Button x:Name="LoginButton" IsDefault="True" FontSize="20" Padding="8" Click="OnLoginClick" />
            <TextBlock x:Name="ErrorText" Foreground="#FFFF7B7B" FontSize="16" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ConnectingText" Foreground="#FFFFD27B" FontSize="16" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed" />
        </StackPanel>

        <TextBlock x:Name="NoticeText" Foreground="#FFB0B8C0" FontSize="14" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   MaxWidth="900" Margin="24,0,24,32" />
    </Grid>
</Window>

<Window x:Class="PcGuard.Shell.LockOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" SizeToContent="WidthAndHeight" Background="#FF1E2A38"
        AllowsTransparency="False" Title="PcGuard">
    <StackPanel Orientation="Horizontal" Margin="16,8">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="NameText" Foreground="White" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="RemainingText" Foreground="#FFFFD27B" FontSize="14" />
        </StackPanel>
        <Button x:Name="SignOutButton" Margin="20,0,0,0" Padding="12,4" VerticalAlignment="Center"
                Click="OnSignOut" />
    </StackPanel>
</Window>

# Copy to .env and fill in real values. Never commit the real .env — see
# .gitignore. Full narrative for every var: docs/PROJECT_KNOWLEDGE.md §12.

DATABASE_URL=postgresql+asyncpg://postgres:123@localhost:5432/Student_Platform
APP_NAME=Student Programming Platform
APP_VERSION=1.0.0
DEBUG=false

# Required, no default — startup fails loudly if missing. Sign JWTs. Min 16 chars.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.py,.js,.html,.css,.json,.md,.txt,.zip

# Comma-separated (also tolerates legacy JSON-list syntax: ["https://a","https://b"]).
# WILDCARD FORBIDDEN — must list every real frontend origin. Forgetting the
# production frontend origin here breaks it silently after deploy: requests
# fail CORS in the browser with no server-side error to grep for.
# Local dev default only — production .env MUST override this.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# management-v2's student_platform integration shim (see PROJECT_KNOWLEDGE.md §10.6).
MGMT_INTEGRATION_URL=https://office.gennis.uz/api/v1/integrations/student-platform

# Shared secret verifying classroom's SSO handoff (POST /auth/sso). Empty = 503, not an open door.
SSO_SHARED_SECRET=

# Comma-separated, valid values: groq, gemini, openai. Currently openai-only in
# practice — re-adding a fallback without a configured key reintroduces a past
# outage (PROJECT_KNOWLEDGE.md §7.1).
AI_PROVIDER_CHAIN=openai

OPENAI_BASE_URL=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

GROK_API_URL=https://api.groq.com/openai/v1/chat/completions
GROK_API_KEY=
GROK_MODEL=llama-3.3-70b-versatile

# Outbound proxy for AI calls (geo-block bypass). Empty = no proxy.
HTTP_PROXY=

# Read-only public scope. Empty = unauthenticated GitHub API, capped 60/hr/IP.
GITHUB_TOKEN=

# 0 disables AI review entirely.
MAX_AI_REVIEWS_PER_DAY=20

# Telegram parent-bot notification on team-game completion. Empty PARENT_BOT_URL
# disables the integration cleanly (no error, just no outbound push).
PARENT_BOT_URL=
PARENT_BOT_SECRET=
